qmake: FORCE
	@$(QMAKE) -o Makefile VirtualTuringMachine.pro

qmake_all: FORCE

VirtualTuringMachine.app/Contents/PkgInfo: 
	@test -d VirtualTuringMachine.app/Contents || mkdir -p VirtualTuringMachine.app/Contents
	@$(DEL_FILE) VirtualTuringMachine.app/Contents/PkgInfo
	@echo "APPL????" > VirtualTuringMachine.app/Contents/PkgInfo
VirtualTuringMachine.app/Contents/Resources/empty.lproj: 
	@test -d VirtualTuringMachine.app/Contents/Resources || mkdir -p VirtualTuringMachine.app/Contents/Resources
	@touch VirtualTuringMachine.app/Contents/Resources/empty.lproj
	
VirtualTuringMachine.app/Contents/Info.plist: 
	@test -d VirtualTuringMachine.app/Contents || mkdir -p VirtualTuringMachine.app/Contents
	@$(DEL_FILE) VirtualTuringMachine.app/Contents/Info.plist
	@sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.VirtualTuringMachine,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.VirtualTuringMachine,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},10.13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,@ICON@,app.icns,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},app.icns,g" -e "s,@EXECUTABLE@,VirtualTuringMachine,g" -e "s,@LIBRARY@,VirtualTuringMachine,g" -e "s,\$${EXECUTABLE_NAME},VirtualTuringMachine,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" MyAppInfo.plist >VirtualTuringMachine.app/Contents/Info.plist
VirtualTuringMachine.app/Contents/Resources/app.icns: Resources/app.icns
	@test -d VirtualTuringMachine.app/Contents/Resources/ || mkdir -p VirtualTuringMachine.app/Contents/Resources/
	@$(DEL_FILE) VirtualTuringMachine.app/Contents/Resources/app.icns
	@$(COPY_FILE) Resources/app.icns VirtualTuringMachine.app/Contents/Resources/app.icns

all: Makefile \
		VirtualTuringMachine.app/Contents/PkgInfo \
		VirtualTuringMachine.app/Contents/Resources/empty.lproj \
		VirtualTuringMachine.app/Contents/Info.plist \
		VirtualTuringMachine.app/Contents/Resources/app.icns VirtualTuringMachine.app/Contents/MacOS/VirtualTuringMachine

