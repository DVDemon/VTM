

#include "VMTAlphabit.h"

#include <QDebug>
#include <stdexcept>

VMTAlphabit::~VMTAlphabit() { qDebug() << "VMTAlphabit::~VMTAlphabit"; }

VMTAlphabit::VMTAlphabit() {}

bool VMTAlphabit::operator!=(const VMTAlphabit& other) const {
    if (_signs.length() != other._signs.length())
        return false;
    else {
        for (int i = 0; i < _signs.length(); i++) {
            bool found = false;
            for (int j = 0; (j < other._signs.length()) && (!found); j++) {
                if (_signs[i] == other._signs[j]) found = true;
            }
            if (!found) return false;
        }

        return true;
    }
}

VMTAlphabit::VMTAlphabit(const VMTAlphabit& other) { _signs = other._signs; }

void VMTAlphabit::ReplaceString(const QString& other) { _signs = other; }

void VMTAlphabit::AddSign(char sign) { _signs.append(QChar(sign)); }

